# ==========================================
# MANORAKSHA - Environment Configuration
# ==========================================

# Application
APP_ENV=development
APP_NAME=MANORAKSHA

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manoraksha

# Redis
REDIS_URL=redis://localhost:6379

# AI Provider
# Keep the real API key ONLY in your hosting provider's secret settings.
AI_PROVIDER=
AI_API_KEY=

# Security
# Generate a strong random value for production.
JWT_SECRET=

# Optional
LOG_LEVEL=INFO
